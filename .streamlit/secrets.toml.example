# Copy this file to .streamlit/secrets.toml and fill in your own Supabase
# connection string. NEVER commit the real secrets.toml to git.
#
# Where to find this value:
#   Supabase dashboard -> your project -> Project Settings -> Database
#   -> Connection string -> URI (choose "Connection pooling" / Transaction mode)
#
# It looks like:
#   postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
#
# Replace [YOUR-PASSWORD] with your actual database password (URL-encode any
# special characters such as @ : / ? # etc.).

DATABASE_URL = "postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres"
